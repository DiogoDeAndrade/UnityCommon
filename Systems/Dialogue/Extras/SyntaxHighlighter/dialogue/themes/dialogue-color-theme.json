{
    "name": "Dialogue Theme",
    "type": "dark",
    "colors": {},
    "tokenColors": [
      {
        "scope": "comment.line.dialogue",
        "settings": { "foreground": "#56ac61" }
      },
      {
        "scope": "comment.block.dialogue",
        "settings": { "foreground": "#56ac61" }
      },
      {
        "scope": "entity.name.section.dialogue",
        "settings": { "foreground": "#00FFFF" }
      },
      {
        "scope": "entity.name.speaker.dialogue",
        "settings": { "foreground": "#FF7777" }
      },
      {
        "scope": "keyword.operator.redirect.dialogue",
        "settings": { "foreground": "#bd62a6" }
      },
      {
        "scope": "meta.code.dialogue",
        "settings": { "foreground": "#99dfdb" }
      },
      {
        "scope": "string.quoted.dialogue",
        "settings": { "foreground": "#f8cd7d" }
      },
      {
        "scope": "entity.name.title.dialogue",
        "settings": { "foreground": "#5298c7" }
      },
      {
        "scope": "markup.bold.choice.dialogue",
        "settings": { "foreground": "#F8cd7d", "fontStyle": "italic" }
      },
      {
        "scope": "punctuation.definition.attribute.dialogue",
        "settings": { "foreground": "#8a5fbf" }
      },
      {
        "scope": "variable.other.attribute.dialogue",
        "settings": { "foreground": "#b57edc" }
      },
      {
        "scope": "keyword.operator.assignment.dialogue",
        "settings": { "foreground": "#8a5fbf" }
      },
      {
        "scope": "string.unquoted.attribute.dialogue",
        "settings": { "foreground": "#d9b8ff" }
      },
      {
        "scope": "constant.numeric.weight.dialogue",
        "settings": { "foreground": "#ff9d5c", "fontStyle": "bold" }
      },
      {
        "scope": "meta.code.dialogue comment",
        "settings": { "foreground": "#56ac61" }
      },
      {
        "scope": "meta.code.dialogue keyword",
        "settings": { "foreground": "#c586c0" }
      },
      {
        "scope": [
          "meta.code.dialogue storage",
          "meta.code.dialogue keyword.type",
          "meta.code.dialogue entity.name.type"
