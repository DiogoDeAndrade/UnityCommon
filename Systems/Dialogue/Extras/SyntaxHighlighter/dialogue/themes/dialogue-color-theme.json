      {
        "scope": "meta.code.dialogue keyword.operator",
        "settings": { "foreground": "#99dfdb" }
      },
      {
        "scope": "meta.code.dialogue string",
        "settings": { "foreground": "#ce9178" }
      },
      {
        "scope": [
          "meta.code.dialogue constant.numeric",
          "meta.code.dialogue constant.language"
        ],
        "settings": { "foreground": "#b5cea8" }
      },
      {
        "scope": "meta.code.dialogue entity.name.function",
        "settings": { "foreground": "#dcdcaa" }
      },
      {
        "scope": "meta.code.dialogue variable",
        "settings": { "foreground": "#9cdcfe" }
      },
      {
        "scope": "meta.interpolation.dialogue",
        "settings": { "foreground": "#7ce38b" }
      },
      {
        "scope": [
          "markup.inserted.punctuation.begin.dialogue",
          "markup.inserted.punctuation.end.dialogue"
        ],
        "settings": { "foreground": "#7ce38b", "fontStyle": "bold" }
      }
    ]
