{
	"scopeName": "source.dialogue",
	"name": "Dialogue",
	"patterns": [
	  {
		"begin": "/\\*",
		"end": "\\*/",
		"name": "comment.block.dialogue"
	  },
	  {
		"match": "//.*",
		"name": "comment.line.dialogue"
	  },
	  {
		"comment": "include(\"Name\") - a reference to another dialogue file",
		"match": "^\\s*(include)\\s*(\\()\\s*(\"[^\"]*\")\\s*(\\))\\s*;?\\s*$",
		"captures": {
		  "1": { "name": "keyword.control.include.dialogue" },
		  "2": { "name": "punctuation.definition.include.dialogue" },
		  "3": { "name": "string.quoted.include.dialogue" },
		  "4": { "name": "punctuation.definition.include.dialogue" }
		}
	  },
	  {
		"match": "^(#\\s*[A-Za-z0-9:_-]+)",
		"name": "entity.name.title.dialogue"
	  },
	  {
		"match": "^\\s*(\\[.*?\\]:)([^\n]*)",
		"captures": {
		  "1": { "name": "entity.name.speaker.dialogue" },
		  "2": {
			"name": "string.quoted.dialogue",
			"patterns": [ { "include": "#interpolation" } ]
		  }
		}
	  },
	  {
		"match": "^\\s*(@)([A-Za-z0-9_.-]+)(?:\\s*(=)\\s*([^\n]*))?",
		"captures": {
		  "1": { "name": "punctuation.definition.attribute.dialogue" },
		  "2": { "name": "variable.other.attribute.dialogue" },
		  "3": { "name": "keyword.operator.assignment.dialogue" },
		  "4": {
			"name": "string.unquoted.attribute.dialogue",
			"patterns": [ { "include": "#interpolation" } ]
		  }
		}
	  },
	  {
		"comment": "-> History(-1) / -> Marker(name) special jump targets",
		"match": "(?<=->|=>)\\s*(History|Marker)\\s*(\\()\\s*([A-Za-z0-9:_-]+)\\s*(\\))",
		"captures": {
		  "1": { "name": "keyword.control.tag.dialogue" },
		  "2": { "name": "punctuation.definition.target.dialogue" },
		  "3": { "name": "constant.other.target.dialogue" },
		  "4": { "name": "punctuation.definition.target.dialogue" }
		}
	  },
	  {
		"comment": "-> End: the reserved end-the-conversation target",
		"match": "(?<=->|=>)\\s*(End)\\s*$",
		"captures": {
		  "1": { "name": "keyword.control.tag.dialogue" }
		}
	  },
	  {
		"match": "=>|->",
		"name": "keyword.operator.redirect.dialogue"
	  },
	  {
		"match": "^\\s*\\{\\s*[0-9]+(?:\\.[0-9]+)?\\s*%?\\s*\\}",
		"name": "constant.numeric.weight.dialogue"
	  },
	  {
		"comment": "Tag line: {OneShot}, {ShowInvalid, Random}, {Marker=xpto}... - a whole line of flags/tags",
		"match": "^\\s*\\{\\s*[A-Za-z_][A-Za-z0-9_]*(\\s*=\\s*[^},;]+)?(\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*(\\s*=\\s*[^},;]+)?)*\\s*\\}\\s*$",
		"name": "keyword.control.tag.dialogue"
	  },
	  {
		"comment": "{OneShot}{ / {GlobalOneShot}{ - a one-shot marker prefixing an entry code block",
		"match": "^\\s*(\\{\\s*(?:OneShot|GlobalOneShot)\\s*\\})(?=\\s*\\{)",
		"captures": {
		  "1": { "name": "keyword.control.tag.dialogue" }
		}
	  },
	  {
		"begin": "(\\{)",
		"end": "(\\})",
		"name": "meta.code.dialogue",
		"beginCaptures": {
		  "1": { "name": "punctuation.section.code.begin.dialogue" }
		},
		"endCaptures": {
		  "1": { "name": "punctuation.section.code.end.dialogue" }
		},
		"patterns": [
		  {
			"comment": "One-shot markers inside option guards: {OneShot && HasRations(500)}*...",
			"match": "\\b(OneShot|GlobalOneShot)\\b",
			"name": "keyword.control.tag.dialogue"
		  },
		  {
			"include": "source.cs"
		  }
		]
	  },
	  {
		"match": "^(?![#\\*\\{\\[@].*?$)(.+)",
		"captures": {
		  "1": {
			"name": "string.quoted.dialogue",
			"patterns": [ { "include": "#interpolation" } ]
		  }
		}
	  },
	  {
		"match": "(?<==>\\s?|->\\s?)([A-Za-z0-9:_-]+)",
		"name": "entity.name.title.dialogue"
	  },
	  {
		"match": "^\\*(.*?)(?=\\s*(?:->|=>))",
		"captures": {
		  "1": {
			"name": "markup.bold.choice.dialogue",
			"patterns": [ { "include": "#interpolation" } ]
		  }
		}
	  }
	],
	"repository": {
	  "interpolation": {
		"comment": "${expression} inside text. Scoped as markup.inserted so it is green in the stock VS Code themes too, not only in the Dialogue Theme",
		"match": "(\\$\\{)([^}]*)(\\})",
		"name": "meta.interpolation.dialogue",
		"captures": {
		  "1": { "name": "markup.inserted.punctuation.begin.dialogue" },
		  "2": { "name": "markup.inserted.interpolation.dialogue" },
		  "3": { "name": "markup.inserted.punctuation.end.dialogue" }
		}
	  }
	}
  }
